<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW INVOICE"
        android:textStyle="bold"
        android:textSize="24sp"
        android:layout_gravity="center"/>

    <!-- Invoice Number -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Invoice Number">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etInvoiceNo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Date -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Date"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etDate"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buyer -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buyer Name"
        android:layout_marginTop="10dp">

      <AutoCompleteTextView
          android:id="@+id/actBuyer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- GST -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="GSTIN"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etGST"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- State -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="State"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etState"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Address -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Address"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etAddress"
          android:layout_width="match_parent"
          android:layout_height="100dp"
          android:gravity="top"
          android:inputType="textMultiLine"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Product -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/spProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Quantity -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etQty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="numberDecimal"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Rate -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Rate"
        android:layout_marginTop="10dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etRate"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="numberDecimal"/>

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD PRODUCT"
        android:layout_marginTop="15dp"/>

    <!-- Product List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="15dp"/>

    <!-- Totals -->

    <TextView
        android:id="@+id/txtSubTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sub Total : ₹0.00"
        android:textSize="18sp"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtCGST"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CGST (9%) : ₹0.00"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/txtSGST"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SGST (9%) : ₹0.00"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/txtAmountWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amount in Words"
        android:textStyle="italic"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtGrandTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grand Total : ₹0.00"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnGeneratePdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GENERATE PDF"
        android:layout_marginTop="20dp"/>

  </LinearLayout>

</ScrollView>